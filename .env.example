# ---- LLM (本地 vLLM AsyncLLMEngine，程式內嵌，不透過 HTTP) ----
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_QUANTIZATION=awq
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_ENFORCE_EAGER=true

# ---- Embedding (本地 Ollama，跟生成模型分開) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- 網路搜尋工具 (DuckDuckGo，免 API Key) ----

# ---- PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://gigabyte:gigabyte@localhost:5432/gigabyte_agent
DATABASE_URL_SYNC=postgresql://gigabyte:gigabyte@localhost:5432/gigabyte_agent

# ---- Agent ----
MAX_REACT_STEPS=6
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW_MESSAGES=20
MAX_STORED_MESSAGES_PER_CONVERSATION=500

# ---- 語音輸入 (本地 faster-whisper) ----
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- 硬體資訊 WebSocket ----
SYSTEM_WS_INTERVAL_SECONDS=2.0

# ---- 檔案上傳 / LlamaIndex 攝取 ----
UPLOAD_CHUNK_SIZE=500
UPLOAD_CHUNK_OVERLAP=150
UPLOAD_MAX_FILE_SIZE_MB=100

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173
